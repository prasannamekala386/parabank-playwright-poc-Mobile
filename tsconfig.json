{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "strict": true,
    "types": ["node", "@playwright/test"],
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["playwright.config.ts", "fixtures/**/*.ts", "pages/**/*.ts", "tests/**/*.ts", "utils/**/*.ts"]
}
